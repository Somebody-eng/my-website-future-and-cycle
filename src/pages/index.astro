---
import { ArrowRight, BrainCircuit, Building2, Cpu, Search, Sprout } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import DailyQuote from "@components/DailyQuote.astro";
import PeopleMap from "@components/PeopleMap.astro";
import { categories, categoryHref, SITE_DESCRIPTION, SITE_NAME } from "@lib/site";
import { getPublishedPosts } from "@lib/posts";

const posts = await getPublishedPosts();
const weeklyPost = posts.find((post) => post.slug === "owner-earnings-buffett") ?? posts[0];
const latest = posts.slice(0, 6);
const recentlyUpdated = [...posts].sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()).slice(0, 6);
const meetingPosts = posts.filter((post) => post.data.category === "伯克希尔股东会实录").sort((a, b) => Number(b.slug.match(/\d{4}/)?.[0]) - Number(a.slug.match(/\d{4}/)?.[0]));
const meetingPreviewPosts = meetingPosts.slice(0, 5).map((post) => {
  const year = post.slug.match(/\d{4}/)?.[0] ?? "";
  return { post, year, displayTitle: post.data.title.replace(`${year}年伯克希尔股东会实录：`, "") };
});
const latestDate = posts.reduce((date, post) => post.data.updatedDate > date ? post.data.updatedDate : date, posts[0]?.data.updatedDate ?? new Date());

const readingEntrances = [
  { title: "看懂一门好生意", description: "从商业模式、现金流与护城河判断企业质量。", icon: Building2, href: categoryHref("好生意案例库"), links: ["商业模式与护城河", "现金流与财务质量", "定价权与竞争优势"] },
  { title: "提升决策质量", description: "用思维模型、概率和反向思考减少错误。", icon: BrainCircuit, href: categoryHref("芒格的思维模型"), links: ["决策框架与思维模型", "风险识别与概率思维", "激励机制与行为偏差"] },
  { title: "建立长期能力", description: "把长期主义转化为职业、学习与副业选择。", icon: Sprout, href: categoryHref("长期主义与普通人"), links: ["职业护城河", "能力复利", "副业与个人经营"] }
];

const paths = [
  { index: "01", title: "企业质量", href: categoryHref("好生意案例库"), topics: ["现金流", "护城河", "定价权", "资本回报", "管理层"] },
  { index: "02", title: "理性决策", href: categoryHref("芒格的思维模型"), topics: ["多元模型", "反向思考", "概率", "激励机制", "能力圈"] },
  { index: "03", title: "AI 与科技", href: categoryHref("AI与科技巨头"), topics: ["算力经济", "平台生态", "资本开支", "技术周期", "竞争优势"] },
  { index: "04", title: "经营者思想", href: categoryHref("人物思想地图"), topics: ["资本配置", "企业文化", "消费者导向", "长期主义", "第一性原理"] }
];
const formatDate = (date: Date) => date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <div class="home-shell container">
    <section class="weekly-grid" aria-labelledby="weekly-title">
      <article class="weekly-feature">
        <p class="section-label">本周核心问题</p>
        <h1 id="weekly-title">现金流如何决定<br />企业的战略自由度？</h1>
        <p class="weekly-summary">真正的战略选择不来自愿景，而来自现金流的可支配性。拥有持续产生自由现金流的能力，企业才有余地穿越不确定性、投入未来，并等待真正重要的机会。</p>
        <a class="read-link" href={`/posts/${weeklyPost.slug}/`}>阅读专题文章 <ArrowRight size={17} stroke-width={1.6} /></a>
      </article>
      <aside class="weekly-discovery" aria-label="站内发现">
        <form class="home-search" action="/search/" method="get">
          <Search size={21} stroke-width={1.6} aria-hidden="true" />
          <label class="sr-only" for="home-search-input">搜索全站文章</label>
          <input id="home-search-input" name="q" type="search" placeholder="搜索文章、人物、概念与案例" autocomplete="off" />
          <button type="submit" aria-label="开始搜索"><ArrowRight size={19} stroke-width={1.6} /></button>
        </form>
        <dl class="publication-stats">
          <div><dt>文章</dt><dd>{posts.length}</dd></div><div><dt>专题栏目</dt><dd>{categories.length}</dd></div>
          <div><dt>股东会实录</dt><dd>{meetingPosts.length}</dd></div><div><dt>最近更新</dt><dd>{formatDate(latestDate)}</dd></div>
        </dl>
        <DailyQuote />
      </aside>
    </section>

    <section class="reading-entrances" aria-labelledby="entrances-title">
      <div class="section-intro"><p class="section-label">从问题出发</p><h2 id="entrances-title">你今天想解决什么？</h2></div>
      <div class="entrance-grid">
        {readingEntrances.map((entrance) => {
          const Icon = entrance.icon;
          return <article class="entrance-item">
            <div class="entrance-title"><Icon size={25} stroke-width={1.35} aria-hidden="true" /><h3>{entrance.title}</h3></div>
            <p>{entrance.description}</p>
            <ul>{entrance.links.map((link) => <li><a href={`/search/?q=${encodeURIComponent(link)}`}>{link}<ArrowRight size={14} stroke-width={1.5} /></a></li>)}</ul>
            <a class="entrance-all" href={entrance.href}>进入阅读路径</a>
          </article>;
        })}
      </div>
    </section>

    <section id="paths" class="topic-paths" aria-labelledby="paths-title">
      <div class="section-heading"><div><p class="section-label">CURATED PATHS</p><h2 id="paths-title">专题阅读路径</h2></div><a href="/search/">检索全部文章 <ArrowRight size={16} stroke-width={1.5} /></a></div>
      <div class="path-list">
        {paths.map((path) => <a class="path-row" href={path.href}><span class="path-index">{path.index}</span><strong>{path.title}</strong><span class="path-topics">{path.topics.map((topic) => <span>{topic}</span>)}</span><ArrowRight class="path-arrow" size={17} stroke-width={1.5} /></a>)}
      </div>
    </section>

    <section class="archive-and-tech">
      <div class="meeting-series" aria-labelledby="meeting-series-title">
        <div class="section-heading"><div><p class="section-label">CHRONOLOGICAL ARCHIVE</p><h2 id="meeting-series-title">伯克希尔股东会实录</h2></div><a href={categoryHref("伯克希尔股东会实录")}>完整年份 <ArrowRight size={16} stroke-width={1.5} /></a></div>
        <div class="meeting-timeline">
          {meetingPreviewPosts.map(({ post, year, displayTitle }) => <a href={`/posts/${post.slug}/`}><time>{year}</time><span>{displayTitle}</span></a>)}
        </div>
      </div>
      <aside class="tech-focus"><Cpu size={25} stroke-width={1.35} /><p class="section-label">持续观察</p><h2>AI 的热度很高，商业规律并没有失效。</h2><p>从资本开支、单位经济、平台生态和现金流约束出发，拆解科技巨头的真实竞争力。</p><a href={categoryHref("AI与科技巨头")}>进入 AI 与科技专题 <ArrowRight size={16} stroke-width={1.5} /></a></aside>
    </section>

    <section id="latest" class="publishing-index" aria-labelledby="publishing-title">
      <div class="section-heading"><div><p class="section-label">WHAT'S NEW</p><h2 id="publishing-title">持续更新的研究笔记</h2></div><a href="/search/">查看全部 <ArrowRight size={16} stroke-width={1.5} /></a></div>
      <div class="publishing-columns">
        <div><h3>最新发布</h3><div class="article-index">{latest.map((post) => <a href={`/posts/${post.slug}/`}><span>{post.data.title}</span><small>{post.data.category}</small><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></a>)}</div></div>
        <div><h3>最近更新</h3><div class="article-index">{recentlyUpdated.map((post) => <a href={`/posts/${post.slug}/`}><span>{post.data.title}</span><small>{post.data.category}</small><time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></a>)}</div></div>
      </div>
    </section>

    <section id="people" class="people-section" aria-labelledby="people-title">
      <div class="people-copy"><p class="section-label">PEOPLE & IDEAS</p><h2 id="people-title">长期主义者的思想与实践</h2><p>从人物进入方法论，再回到企业经营与普通人的选择。</p></div><PeopleMap />
    </section>

    <section class="all-categories" aria-labelledby="categories-title">
      <div class="section-heading"><div><p class="section-label">KNOWLEDGE INDEX</p><h2 id="categories-title">全部栏目</h2></div></div>
      <div class="category-grid">{categories.map((category, index) => <a href={categoryHref(category.name)}><span>{String(index + 1).padStart(2, "0")}</span><strong>{category.name}</strong><small>{category.description}</small><ArrowRight size={16} stroke-width={1.5} /></a>)}</div>
    </section>
  </div>
</BaseLayout>

<style>@import "../styles/home.css";</style>