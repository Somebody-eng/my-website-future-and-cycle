---
import { ArrowRight, BookOpenText, Search } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import SearchBox from "@components/SearchBox.astro";
import { categories } from "@lib/site";
import { getPublishedPosts } from "@lib/posts";

const posts = await getPublishedPosts();
const popularTerms = ["现金流", "护城河", "定价权", "芒格", "AI", "资本配置"];
---

<BaseLayout title="全站搜索" description="搜索未来与周期的文章正文、商业概念、人物、案例、栏目与标签。" canonical="/search/">
  <section class="search-page">
    <div class="container search-layout">
      <div class="search-main">
        <Breadcrumb items={[{ label: "全站搜索" }]} />
        <header>
          <p class="eyebrow">SEARCH THE KNOWLEDGE BASE</p>
          <h1>搜索文章、人物、概念与案例</h1>
          <span>在 {posts.length} 篇研究笔记与实录中检索标题、标签和正文。</span>
        </header>
        <SearchBox placeholder={`搜索 ${posts.length} 篇文章的完整正文`} />
        <div class="search-toolbar">
          <div class="category-filters" aria-label="按栏目筛选">
            <button class="active" type="button" data-category="">全部</button>
            {categories.map((category) => <button type="button" data-category={category.name}>{category.name.replace("伯克希尔股东会实录", "股东会实录").replace("长期主义与普通人", "长期主义")}</button>)}
          </div>
          <span id="result-count" aria-live="polite">正在载入索引…</span>
        </div>
        <div id="search-results" class="results" aria-live="polite" aria-busy="true"></div>
      </div>

      <aside class="search-guide">
        <Search size={23} stroke-width={1.45} aria-hidden="true" />
        <h2>从一个问题开始</h2>
        <p>输入完整问题或多个关键词，例如“现金流 护城河”。搜索会优先展示标题和标签匹配，并从正文中截取相关上下文。</p>
        <div class="popular-searches">
          <h3>常用检索</h3>
          {popularTerms.map((term) => <button type="button" data-search-term={term}>{term}<ArrowRight size={14} stroke-width={1.5} /></button>)}
        </div>
        <a class="browse-link" href="/#paths"><BookOpenText size={16} stroke-width={1.5} />按专题路径浏览</a>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  interface SearchItem {
    title: string; description: string; category: string; tags: string[]; url: string;
    date: string; updatedDate: string; readingTime: number; content: string;
  }

  const input = document.querySelector<HTMLInputElement>("#site-search");
  const results = document.querySelector<HTMLElement>("#search-results");
  const count = document.querySelector<HTMLElement>("#result-count");
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-category]")];
  let index: SearchItem[] = [];
  let selectedCategory = "";

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character] ?? character);
  const escapeRegex = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const tokensFor = (value: string) => value.trim().toLocaleLowerCase("zh-CN").split(/\s+/).filter(Boolean);

  function highlight(value: string, tokens: string[]) {
    let safe = escapeHtml(value);
    for (const token of [...tokens].sort((a, b) => b.length - a.length)) {
      safe = safe.replace(new RegExp(escapeRegex(escapeHtml(token)), "gi"), (match) => `<mark>${match}</mark>`);
    }
    return safe;
  }

  function makeSnippet(item: SearchItem, tokens: string[]) {
    const source = item.content || item.description;
    const lower = source.toLocaleLowerCase("zh-CN");
    const positions = tokens.map((token) => lower.indexOf(token)).filter((position) => position >= 0);
    const first = positions.length ? Math.min(...positions) : 0;
    const start = Math.max(0, first - 58);
    const end = Math.min(source.length, start + 170);
    return `${start > 0 ? "…" : ""}${source.slice(start, end)}${end < source.length ? "…" : ""}`;
  }

  function score(item: SearchItem, tokens: string[]) {
    const title = item.title.toLocaleLowerCase("zh-CN");
    const description = item.description.toLocaleLowerCase("zh-CN");
    const category = item.category.toLocaleLowerCase("zh-CN");
    const tags = item.tags.join(" ").toLocaleLowerCase("zh-CN");
    const content = item.content.toLocaleLowerCase("zh-CN");
    if (!tokens.every((token) => `${title} ${description} ${category} ${tags} ${content}`.includes(token))) return -1;
    return tokens.reduce((total, token) => total + (title.includes(token) ? 12 : 0) + (tags.includes(token) ? 7 : 0) + (category.includes(token) ? 5 : 0) + (description.includes(token) ? 3 : 0) + (content.includes(token) ? 1 : 0), 0);
  }

  function renderStart() {
    if (!results) return;
    results.innerHTML = `<div class="start-state"><strong>输入关键词开始全文检索</strong><p>也可以选择上方栏目，查看该栏目全部文章。</p></div>`;
    results.setAttribute("aria-busy", "false");
    if (count) count.textContent = `已收录 ${index.length} 篇`;
  }

  function runSearch(updateUrl = true) {
    if (!results || !input) return;
    const query = input.value.trim();
    const tokens = tokensFor(query);
    const matches = index
      .filter((item) => !selectedCategory || item.category === selectedCategory)
      .map((item) => ({ item, score: tokens.length ? score(item, tokens) : 0 }))
      .filter(({ score }) => score >= 0)
      .sort((a, b) => b.score - a.score || Date.parse(b.item.updatedDate) - Date.parse(a.item.updatedDate));

    if (!query && !selectedCategory) { renderStart(); return; }
    if (count) count.textContent = `找到 ${matches.length} 篇`;
    results.setAttribute("aria-busy", "false");
    if (!matches.length) {
      results.innerHTML = `<div class="empty"><strong>没有找到匹配内容</strong><p>试试更短的关键词、人物姓名，或切换到“全部”栏目。</p></div>`;
    } else {
      results.innerHTML = matches.map(({ item }, position) => `
        <article class="result-item">
          <span class="result-number">${String(position + 1).padStart(2, "0")}</span>
          <div class="result-content">
            <div class="result-meta"><span>${escapeHtml(item.category)}</span><time>${new Date(item.updatedDate).toLocaleDateString("zh-CN")}</time><span>${item.readingTime} 分钟</span></div>
            <h2><a href="${item.url}">${highlight(item.title, tokens)}</a></h2>
            <p>${highlight(makeSnippet(item, tokens), tokens)}</p>
            <div class="result-tags">${item.tags.slice(0, 4).map((tag) => `<span>#${highlight(tag, tokens)}</span>`).join("")}</div>
          </div>
        </article>`).join("");
    }

    if (updateUrl) {
      const url = new URL(window.location.href);
      query ? url.searchParams.set("q", query) : url.searchParams.delete("q");
      selectedCategory ? url.searchParams.set("category", selectedCategory) : url.searchParams.delete("category");
      history.replaceState(null, "", url);
    }
  }

  async function initialize() {
    try {
      const response = await fetch(new URL("../search-index.json", window.location.href));
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      index = await response.json();
      const params = new URLSearchParams(window.location.search);
      input!.value = params.get("q") || "";
      selectedCategory = params.get("category") || "";
      filterButtons.forEach((button) => button.classList.toggle("active", button.dataset.category === selectedCategory));
      runSearch(false);
    } catch (error) {
      if (count) count.textContent = "索引载入失败";
      if (results) results.innerHTML = `<div class="empty"><strong>搜索暂时无法使用</strong><p>请刷新页面后重试。</p></div>`;
    }
  }

  input?.addEventListener("input", () => runSearch());
  filterButtons.forEach((button) => button.addEventListener("click", () => {
    selectedCategory = button.dataset.category || "";
    filterButtons.forEach((item) => item.classList.toggle("active", item === button));
    runSearch();
  }));
  document.querySelectorAll<HTMLButtonElement>("[data-search-term]").forEach((button) => button.addEventListener("click", () => {
    if (!input) return;
    input.value = button.dataset.searchTerm || "";
    input.focus();
    runSearch();
  }));
  initialize();
</script>

<style>
  .search-page{padding:32px 0 70px}.search-main{min-width:0}.search-layout{display:grid;grid-template-columns:minmax(0,880px) minmax(240px,1fr);gap:70px}.search-main header{margin:45px 0 28px}.search-main h1{margin:0;font-family:"Noto Serif SC","Songti SC",SimSun,serif;font-size:2.6rem;line-height:1.2}.search-main header span{display:block;margin-top:13px;color:var(--muted);font-size:.82rem}.search-toolbar{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-top:22px}.category-filters{display:flex;flex-wrap:wrap;gap:7px}.category-filters button{min-height:32px;padding:4px 10px;border:1px solid var(--line);border-radius:4px;background:#fff;color:var(--muted);font-size:.66rem;cursor:pointer}.category-filters button.active{border-color:var(--text);background:var(--text);color:#fff}#result-count{flex:0 0 auto;padding-top:6px;color:var(--muted);font-size:.68rem}.results{margin-top:22px;border-top:1px solid var(--line)}:global(.result-item){display:grid;grid-template-columns:42px minmax(0,1fr);gap:18px;padding:27px 0;border-bottom:1px solid var(--line)}:global(.result-number){color:var(--accent);font-size:.65rem;font-weight:700}:global(.result-meta){display:flex;flex-wrap:wrap;gap:12px;color:var(--muted);font-size:.64rem}:global(.result-item h2){margin:7px 0 8px;font-family:"Noto Serif SC","Songti SC",SimSun,serif;font-size:1.24rem;line-height:1.45}:global(.result-item h2 a){color:var(--text);text-decoration:none}:global(.result-item p){margin:0;color:var(--text-soft);font-size:.78rem;line-height:1.8}:global(mark){padding:0 .08em;background:var(--accent-soft);color:var(--accent)}:global(.result-tags){display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;color:var(--muted);font-size:.63rem}:global(.start-state),:global(.empty){padding:46px 0;color:var(--muted)}:global(.start-state strong),:global(.empty strong){color:var(--text);font-size:.9rem}:global(.start-state p),:global(.empty p){margin:6px 0 0;font-size:.75rem}.search-guide{margin-top:126px;padding-left:34px;border-left:1px solid var(--line)}.search-guide>svg{color:var(--accent)}.search-guide h2{margin:19px 0 10px;font-family:"Noto Serif SC","Songti SC",SimSun,serif;font-size:1.2rem}.search-guide>p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.8}.popular-searches{display:grid;margin-top:27px;border-top:1px solid var(--line)}.popular-searches h3{margin:18px 0 8px;font-size:.72rem}.popular-searches button{display:flex;align-items:center;justify-content:space-between;min-height:38px;padding:0;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--text-soft);font-size:.7rem;cursor:pointer}.browse-link{display:flex;align-items:center;gap:8px;margin-top:25px;color:var(--accent);font-size:.7rem;text-decoration:none}
  @media(max-width:900px){.search-layout{grid-template-columns:minmax(0,1fr)}.search-guide{display:none}}@media(max-width:640px){.search-page{padding-top:22px}.search-main header{margin:30px 0 24px}.search-main h1{font-size:2rem}.search-toolbar{display:block}.category-filters{overflow-x:auto;flex-wrap:nowrap;padding-bottom:7px}.category-filters button{flex:0 0 auto}#result-count{display:block;margin-top:9px}:global(.result-item){grid-template-columns:28px 1fr;gap:10px;padding:23px 0}:global(.result-item h2){font-size:1.1rem}:global(.result-item p){display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3}}
</style>