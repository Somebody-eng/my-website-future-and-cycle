---
import { BookOpenText, Compass, House, Menu, Rss, Search, UserRound } from "@lucide/astro";
import { SITE_SHORT_NAME } from "@lib/site";

const path = Astro.url.pathname;
const isHome = path === "/";
const meetingHref = "/categories/%E4%BC%AF%E5%85%8B%E5%B8%8C%E5%B0%94%E8%82%A1%E4%B8%9C%E4%BC%9A%E5%AE%9E%E5%BD%95/";
const isMeetings = path.includes("%E4%BC%AF%E5%85%8B%E5%B8%8C%E5%B0%94") || path.includes("伯克希尔股东会实录") || path.includes("berkshire-meeting");
const isTopics = path.startsWith("/categories") || path.startsWith("/tags");
const isIndustries = path.startsWith("/industries") || path.includes("AI%E4%B8%8E%E7%A7%91%E6%8A%80%E5%B7%A8%E5%A4%B4") || path.includes("低空经济与航空科技");
const isPeople = path.includes("idea-maps");
const isSearch = path.startsWith("/search");
---

<header class="topbar">
  <div class="topbar-inner">
    <a class="wordmark" href="/">{SITE_SHORT_NAME}<small>长期主义商业 · 前沿产业研究</small></a>
    <nav class="desktop-nav" aria-label="主导航">
      <a class:list={{ active: isHome }} href="/">今日</a>
      <a href="/#paths">专题</a>
      <a class:list={{ active: isIndustries }} href="/industries/">产业</a>
      <a href="/#people">人物</a>
      <a class:list={{ active: isMeetings }} href={meetingHref}>股东会</a>
    </nav>
    <div class="header-actions">
      <a class:list={["search-link", { active: isSearch }]} href="/search/" aria-label="搜索全站">
        <Search size={20} stroke-width={1.6} aria-hidden="true" /><span>搜索</span>
      </a>
      <details class="mobile-menu">
        <summary aria-label="打开菜单"><Menu size={23} stroke-width={1.6} /></summary>
        <nav aria-label="移动端菜单">
          <a href="/#paths">专题阅读路径</a><a href="/industries/">前沿产业研究</a><a href="/#people">人物思想</a><a href="/categories/%E5%A5%BD%E7%94%9F%E6%84%8F%E6%A1%88%E4%BE%8B%E5%BA%93/">案例库</a>
          <a href={meetingHref}>伯克希尔股东会实录</a><a href="/search/">搜索</a><a href="/about/">关于</a><a href="/disclaimer/">免责声明</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<aside class="side-rail" aria-label="快捷导航">
  <a href="/" class:list={{ active: isHome }}><House size={23} stroke-width={1.45} /><span>今日</span></a>
  <a href="/#paths" class:list={{ active: isTopics }}><Compass size={22} stroke-width={1.45} /><span>专题</span></a>
  <a href={meetingHref} class:list={{ active: isMeetings }}><BookOpenText size={22} stroke-width={1.45} /><span>实录</span></a>
  <a href="/#people" class:list={{ active: isPeople }}><UserRound size={23} stroke-width={1.45} /><span>人物</span></a>
  <a href="/search/" class:list={{ active: isSearch }}><Search size={22} stroke-width={1.45} /><span>检索</span></a>
  <a href="/rss.xml"><Rss size={21} stroke-width={1.45} /><span>RSS</span></a>
</aside>

<nav class="mobile-bottom-nav" aria-label="移动端快捷导航">
  <a href="/" class:list={{ active: isHome }}><House size={22} stroke-width={1.6} /><span>今日</span></a>
  <a href="/#paths" class:list={{ active: isTopics }}><Compass size={22} stroke-width={1.6} /><span>专题</span></a>
  <a href="/search/" class:list={{ active: isSearch }}><Search size={23} stroke-width={1.6} /><span>搜索</span></a>
  <a href={meetingHref} class:list={{ active: isMeetings }}><BookOpenText size={22} stroke-width={1.6} /><span>实录</span></a>
  <a href="/#people" class:list={{ active: isPeople }}><UserRound size={22} stroke-width={1.6} /><span>人物</span></a>
</nav>

<style>
  .topbar{position:sticky;top:0;z-index:40;margin-left:var(--rail-width);border-bottom:1px solid var(--line);background:rgba(255,255,255,.96);backdrop-filter:blur(12px)}
  .topbar-inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;width:min(1280px,calc(100% - 80px));min-height:var(--header-height);margin:0 auto}.wordmark{display:grid;color:var(--text);font-family:"Noto Serif SC","Songti SC",SimSun,serif;font-size:1.08rem;font-weight:700;line-height:1.2;text-decoration:none}.wordmark small{color:var(--muted);font-family:inherit;font-size:.48rem;font-weight:400}.desktop-nav{display:flex;align-items:center;gap:38px}.desktop-nav a,.search-link{position:relative;color:var(--text-soft);font-size:.78rem;text-decoration:none}.desktop-nav a:hover,.search-link:hover,.desktop-nav a.active,.search-link.active{color:var(--text)}.desktop-nav a.active:after{position:absolute;right:0;bottom:-23px;left:0;height:2px;background:var(--accent);content:""}.header-actions{display:flex;justify-content:flex-end}.search-link{display:inline-flex;align-items:center;gap:8px;min-width:44px;min-height:44px}.mobile-menu{display:none;position:relative}.mobile-menu summary{display:grid;place-items:center;width:44px;height:44px;cursor:pointer;list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu nav{position:absolute;top:48px;right:0;display:grid;width:210px;padding:8px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow)}.mobile-menu nav a{padding:11px 12px;color:var(--text);font-size:.82rem;text-decoration:none}
  .side-rail{position:fixed;inset:0 auto 0 0;z-index:45;display:flex;width:var(--rail-width);padding:92px 0 24px;border-right:1px solid var(--line);background:#fff;flex-direction:column;align-items:center;gap:28px}.side-rail a,.mobile-bottom-nav a{position:relative;display:grid;place-items:center;gap:5px;color:var(--text-soft);font-size:.66rem;text-decoration:none}.side-rail a{width:64px;min-height:54px}.side-rail a:before,.mobile-bottom-nav a:after{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--accent);content:"";opacity:0}.side-rail a:before{top:7px;left:-1px}.side-rail a.active,.mobile-bottom-nav a.active{color:var(--accent)}.side-rail a.active:before,.mobile-bottom-nav a.active:after{opacity:1}.mobile-bottom-nav{display:none}
  @media(max-width:900px){.topbar{margin-left:0}.topbar-inner{grid-template-columns:1fr auto;width:calc(100% - 32px)}.desktop-nav,.side-rail,.search-link span{display:none}.header-actions{gap:2px}.mobile-menu{display:block}.mobile-bottom-nav{position:fixed;inset:auto 0 0;z-index:50;display:grid;grid-template-columns:repeat(5,1fr);height:calc(70px + env(safe-area-inset-bottom));padding:8px 4px env(safe-area-inset-bottom);border-top:1px solid var(--line);background:rgba(255,255,255,.97);backdrop-filter:blur(14px)}.mobile-bottom-nav a:after{bottom:0;left:50%;transform:translateX(-50%)}}
</style>
